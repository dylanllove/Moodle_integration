# Copy to .env and fill in.

# --- Moodle (University LMS) ---
# Your Moodle site URL and a Web Services token.
# Get a token: Moodle → Preferences → Security keys (or ask IT to enable the
# "Moodle mobile web service"). The token alone authenticates — a password is
# NOT needed and shouldn't be stored here.
MOODLE_URL=https://learn.your-uni.ac.nz
MOODLE_TOKEN=

# --- OpenAI (AI features + transcription) ---
OPENAI_API_KEY=
AI_MODEL_FAST=gpt-4o-mini
AI_MODEL_DRAFT=gpt-4o
AI_TRANSCRIBE_MODEL=whisper-1

# --- Google Calendar (optional: live deadline sync) ---
# Create an OAuth client (type: Web application) at
# https://console.cloud.google.com/apis/credentials, enable the Google Calendar
# API, and add this redirect URI:  http://127.0.0.1:8787/api/gcal/callback
# Not needed if you'd rather just subscribe Google to /api/calendar.ics.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Notion (optional: deadlines as a Notion database) ---
# An *internal* integration secret from https://www.notion.so/my-integrations.
# Then share the page you want the database in with that integration
# (page → ⋯ → Connections). Settings → "Where your deadlines go" does the rest.
NOTION_TOKEN=

# --- Weekly digest email (optional) ---
# The Sunday-night "what's due this week" email is sent through your own mail
# account over SMTP — nothing routes through a third-party service.
# Gmail requires an App Password (myaccount.google.com → Security → App
# passwords), not your normal password.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Defaults to SMTP_USER if unset.
SMTP_FROM=

# --- Echo360 lecture recordings (optional) ---
# No keys needed — you log in through the browser in-app (Settings → Echo360).
# Optionally pre-seed your section(s) as a JSON array (find the id in your
# Echo360 URL: echo360.net.au/section/<THIS-ID>/home). You can also add them in the UI.
# ECHO360_SECTIONS=[{"sectionId":"xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx","courseId":null,"label":"MYCOURSE"}]

# --- Server ---
PORT=8787

# Where local data lives (SQLite DB, downloaded media, transcripts).
# Defaults to <repo>/data if unset.
DATA_DIR=

# Optional: an iCal export URL for extra calendar events (the API already
# provides deadlines, so this is usually unnecessary).
# ICAL_URL=
